# Environment variables for WORSHIP Mascot Robot Backend
# Add your environment variables below this line

# Groq API configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_here  # Optional: defaults to mixtral-8x7b-32768

# Example:
# GROQ_API_KEY=gsk_yourActualApiKeyHere
# GROQ_MODEL=llama3-8b-8192